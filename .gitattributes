# Normalise line endings so a mixed Windows/macOS/Linux team gets clean diffs.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
Makefile text eol=lf
*.pdf binary
*.png binary

# Vendored libraries and fonts are byte-exact: no line-ending conversion, or the SHA-256 recorded in app/web/static/vendor/README.md stops matching on a Windows checkout
app/web/static/vendor/** -text
app/web/static/fonts/** -text
*.woff2 binary
